# Hermes Model Router — 环境变量模板
# 复制为 ~/.hermes/.env（如果尚未配置）
# 脚本自动从 ~/.hermes/.env 读取，无需额外配置

# Ollama Cloud（qwen3.5, kimi, deepseek-v4-pro/flash, gemma4）
OLLAMA_API_KEY=your_ollama_api_key_here

# 聚鑫（gemini-3.5-flash）
JUXIN_API_KEY=your_juxin_api_key_here

# ZAI（glm-5.2）
ZAI_API_KEY=your_zai_api_key_here
